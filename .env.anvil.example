# Copy into a file Next loads (e.g. `.env.local`):
#   cp .env.anvil.example .env.local
# RainbowKit still needs a WalletConnect Cloud project id for “WalletConnect” wallets in the modal.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed `Nock` on Anvil (chain 31337) — from deployments/anvil-local.json
NEXT_PUBLIC_NOCK_TOKEN_ADDRESS=

# For local deployment (Anvil), chain ID is 31337
NEXT_PUBLIC_WALLETCONNECT_CHAIN_IDS=

# Optional. Nockchain gRPC URL for read-only queries (e.g. Base→Nock fee estimate) when Iris is not connected.
# Use the same URL Iris would pass: default is https://rpc.nockbox.org (host-only default is rpc.nockbox.org;
# see iris/extension/shared/constants.ts RPC_ENDPOINT and iris/extension/shared/rpc-config.ts ensureHttps).
# Users can override in Iris Settings → RPC; that stored rpcUrl is what connect() returns as grpcEndpoint.
# NEXT_PUBLIC_NOCKCHAIN_GRPC_URL=https://rpc.nockbox.org

