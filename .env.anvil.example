# Anvil / local chain: copy `.env.example` to `.env.local` for the full variable list, then set at least:
#   - NEXT_PUBLIC_WALLETCONNECT_CHAIN_IDS=31337 (or include 31337 in the list)
#   - all `NEXT_PUBLIC_BRIDGE_DEV_*` values from your deployment + bridge signer set
#
# Full comments and mainnet (`NEXT_PUBLIC_BRIDGE_MAINNET_*`) vars: see `.env.example`.

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

NEXT_PUBLIC_WALLETCONNECT_CHAIN_IDS=31337

# Secondary bridge profile (Anvil). For production Base mainnet use `NEXT_PUBLIC_BRIDGE_MAINNET_*` in `.env.example`.
NEXT_PUBLIC_BRIDGE_DEV_CHAIN_ID=31337
NEXT_PUBLIC_BRIDGE_DEV_NOCK_TOKEN_ADDRESS=
NEXT_PUBLIC_BRIDGE_DEV_MESSAGE_INBOX_ADDRESS=
NEXT_PUBLIC_BRIDGE_DEV_SIGNER_PKHS=
NEXT_PUBLIC_BRIDGE_DEV_THRESHOLD=
NEXT_PUBLIC_BRIDGE_DEV_LOCK_ROOT=
NEXT_PUBLIC_BRIDGE_DEV_NOCKCHAIN_CONFIRMATION_DEPTH=0

# Optional. Base→Nock fee estimate without Iris; Nock→Base submit still uses Iris `grpcEndpoint`.
# NEXT_PUBLIC_BRIDGE_DEV_NOCKCHAIN_GRPC_URL=https://rpc.nockbox.org

