# Copy to a file Next loads (e.g. `.env.local`):  cp .env.example .env.local
# All keys here are `NEXT_PUBLIC_*` — they are embedded in the client bundle; do not put secrets here.

# -----------------------------------------------------------------------------
# Wallet / chains (RainbowKit + wagmi)
# -----------------------------------------------------------------------------

# Required for WalletConnect wallets in the RainbowKit modal (WalletConnect Cloud project id).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Comma-separated EVM chain IDs wagmi should know about. First id is the default.
# Omit to default to Base mainnet (8453). Local Anvil example: 31337
NEXT_PUBLIC_WALLETCONNECT_CHAIN_IDS=8453

# Optional. Override Base Sepolia RPC, useful for Tenderly virtual networks.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# -----------------------------------------------------------------------------
# Bridge profile: Base mainnet (chain id must match NEXT_PUBLIC_BRIDGE_MAINNET_CHAIN_ID)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_BRIDGE_MAINNET_CHAIN_ID=8453
NEXT_PUBLIC_BRIDGE_MAINNET_NOCK_TOKEN_ADDRESS=
NEXT_PUBLIC_BRIDGE_MAINNET_MESSAGE_INBOX_ADDRESS=

# Comma-separated Nockchain PKH digests (bridge signer set), e.g. pk1,pkh2,...
NEXT_PUBLIC_BRIDGE_MAINNET_SIGNER_PKHS=
NEXT_PUBLIC_BRIDGE_MAINNET_THRESHOLD=
NEXT_PUBLIC_BRIDGE_MAINNET_LOCK_ROOT=
NEXT_PUBLIC_BRIDGE_MAINNET_NOCKCHAIN_CONFIRMATION_DEPTH=100

# Optional. gRPC URL for Base→Nock fee estimate when Iris has not supplied an endpoint.
NEXT_PUBLIC_BRIDGE_MAINNET_NOCKCHAIN_GRPC_URL=

# -----------------------------------------------------------------------------
# Secondary bridge profile (e.g. local Anvil / fakenet — matched by wagmi chain id)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_BRIDGE_DEV_CHAIN_ID=31337
NEXT_PUBLIC_BRIDGE_DEV_NOCK_TOKEN_ADDRESS=
NEXT_PUBLIC_BRIDGE_DEV_MESSAGE_INBOX_ADDRESS=
NEXT_PUBLIC_BRIDGE_DEV_SIGNER_PKHS=
NEXT_PUBLIC_BRIDGE_DEV_THRESHOLD=
NEXT_PUBLIC_BRIDGE_DEV_LOCK_ROOT=
NEXT_PUBLIC_BRIDGE_DEV_NOCKCHAIN_CONFIRMATION_DEPTH=0

# Optional. Same as mainnet, for the dev chain when Iris is not connected.
NEXT_PUBLIC_BRIDGE_DEV_NOCKCHAIN_GRPC_URL=
