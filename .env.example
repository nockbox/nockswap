# Copy to a file Next loads (e.g. `.env.local`):  cp .env.example .env.local
# All keys here are `NEXT_PUBLIC_*` — they are embedded in the client bundle; do not put secrets here.

# -----------------------------------------------------------------------------
# Wallet / chains (RainbowKit + wagmi)
# -----------------------------------------------------------------------------

# Required for WalletConnect wallets in the RainbowKit modal (WalletConnect Cloud project id).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Comma-separated EVM chain IDs wagmi should know about. First id is the default.
# Omit to default to Base mainnet (8453).
NEXT_PUBLIC_WALLETCONNECT_CHAIN_IDS=8453

# Optional. Override the RPC used for Base or Base Sepolia.
NEXT_PUBLIC_BASE_RPC_URL=

# -----------------------------------------------------------------------------
# Bridge profile (chain id must match one of NEXT_PUBLIC_WALLETCONNECT_CHAIN_IDS)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_BRIDGE_CHAIN_ID=8453
NEXT_PUBLIC_BRIDGE_NOCK_TOKEN_ADDRESS=
NEXT_PUBLIC_BRIDGE_MESSAGE_INBOX_ADDRESS=

# Comma-separated Nockchain PKH digests (bridge signer set), e.g. pk1,pkh2,...
NEXT_PUBLIC_BRIDGE_SIGNER_PKHS=
NEXT_PUBLIC_BRIDGE_THRESHOLD=
NEXT_PUBLIC_BRIDGE_LOCK_ROOT=
NEXT_PUBLIC_BRIDGE_NOCKCHAIN_CONFIRMATION_DEPTH=100

# Optional. gRPC URL for Base→Nock fee estimate when Iris has not supplied an endpoint.
NEXT_PUBLIC_BRIDGE_NOCKCHAIN_GRPC_URL=
